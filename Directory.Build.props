<Project>
  <PropertyGroup>
    <!-- Route final builds into a solution-level folder, separated by platform. -->
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\</OutDir>

    <!-- Keep intermediate files out of the source tree, separated by platform. -->
    <IntDir>$(SolutionDir)Intermediate\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
</Project>
